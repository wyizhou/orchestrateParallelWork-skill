{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orchestrate-parallel-work.local/schemas/task-contract.schema.json",
  "title": "Task Contract v1",
  "type": "object",
  "required": ["schema_version", "task_id", "node_id", "goal", "agent_type_id", "feature_points", "modules", "authoritative_inputs", "inputs", "outputs", "constraints", "owned_scopes", "forbidden_scopes", "allowed_external_effects", "completion_criteria", "self_validation", "acceptance"],
  "properties": {
    "schema_version": { "const": "1.0" }, "task_id": { "type": "string", "minLength": 1 }, "node_id": { "type": "string", "minLength": 1 },
    "goal": { "type": "string", "minLength": 1 }, "agent_type_id": { "type": "string", "minLength": 1 },
    "feature_points": { "type": "array", "items": { "$ref": "#/$defs/feature" } }, "modules": { "type": "array", "items": { "$ref": "#/$defs/module" } },
    "authoritative_inputs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "inputs": { "type": "array", "items": { "$ref": "#/$defs/input" } }, "outputs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/output" } },
    "constraints": { "$ref": "#/$defs/stringArray" }, "owned_scopes": { "$ref": "#/$defs/stringArray" }, "forbidden_scopes": { "$ref": "#/$defs/stringArray" },
    "allowed_external_effects": { "$ref": "#/$defs/stringArray" }, "completion_criteria": { "$ref": "#/$defs/stringArray" },
    "self_validation": { "type": "object", "required": ["test_gate", "lint_gate"], "properties": { "test_gate": { "$ref": "#/$defs/gate" }, "lint_gate": { "$ref": "#/$defs/gate" } }, "additionalProperties": false },
    "acceptance": { "type": "object" },
    "validation_brief": { "$ref": "#/$defs/validationBrief" }
  },
  "$defs": {
    "stringArray": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "feature": { "type": "object", "required": ["id", "expected_behavior"], "properties": { "id": { "type": "string", "minLength": 1 }, "expected_behavior": { "type": "string", "minLength": 1 } }, "additionalProperties": false },
    "module": { "type": "object", "required": ["name", "paths"], "properties": { "name": { "type": "string", "minLength": 1 }, "paths": { "$ref": "#/$defs/stringArray" } }, "additionalProperties": false },
    "input": { "type": "object", "required": ["port", "source", "cardinality"], "properties": { "port": { "type": "string", "minLength": 1 }, "source": { "enum": ["edge", "external"] }, "cardinality": { "enum": ["one", "many"] }, "required": { "type": "boolean" }, "artifact_contract_ref": { "type": "string", "minLength": 1 }, "authoritative_input_ref": { "type": "string", "minLength": 1 } }, "additionalProperties": false },
    "output": { "type": "object", "required": ["port", "artifact_contract_ref"], "properties": { "port": { "type": "string", "minLength": 1 }, "artifact_contract_ref": { "type": "string", "minLength": 1 } }, "additionalProperties": false },
    "gate": { "type": "object", "required": ["mode", "steps", "pass_condition", "evidence_contract_ref"], "properties": { "mode": { "enum": ["command", "manual", "schema", "source-check", "equivalent"] }, "reason": { "type": "string", "minLength": 1 }, "steps": { "$ref": "#/$defs/stringArray" }, "pass_condition": { "type": "string", "minLength": 1 }, "evidence_contract_ref": { "type": "string", "minLength": 1 } }, "additionalProperties": false },
    "validationBrief": { "type": "object", "required": ["validation_id", "feature_points", "modules", "authoritative_input_refs", "artifact_refs", "verification_steps"], "properties": { "validation_id": { "type": "string", "minLength": 1 }, "feature_points": { "type": "array", "items": { "$ref": "#/$defs/feature" } }, "modules": { "type": "array", "items": { "$ref": "#/$defs/module" } }, "authoritative_input_refs": { "$ref": "#/$defs/stringArray" }, "artifact_refs": { "$ref": "#/$defs/stringArray" }, "verification_steps": { "$ref": "#/$defs/stringArray" } }, "additionalProperties": false }
  },
  "additionalProperties": false
}
