{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://orchestrate-parallel-work.local/schemas/node-run-registry.schema.json", "title": "Node Run Registry v1",
  "type": "object", "required": ["schema_version", "execution_run_id", "coordinator_agent_instance_id", "entries"],
  "properties": {
    "schema_version": { "const": "1.0" }, "execution_run_id": { "type": "string", "minLength": 1 }, "coordinator_agent_instance_id": { "type": "string", "minLength": 1 },
    "entries": { "type": "array", "items": { "type": "object", "required": ["node_run_id", "node_id", "attempt", "agent_instance_id", "agent_type_id", "status", "input_artifacts", "output_artifacts", "self_checks"],
      "properties": {
        "node_run_id": { "type": "string", "minLength": 1 }, "node_id": { "type": "string", "minLength": 1 }, "attempt": { "type": "integer", "minimum": 1 },
        "agent_instance_id": { "type": "string", "minLength": 1 }, "agent_type_id": { "type": "string", "minLength": 1 },
        "status": { "enum": ["blocked", "ready", "active", "submitted", "accepted", "integrated", "failed", "stale", "skipped", "cancelled"] },
        "input_artifacts": { "type": "array" }, "output_artifacts": { "type": "array", "items": { "type": "string" } },
        "started_at": { "type": "string", "format": "date-time" }, "ended_at": { "type": "string", "format": "date-time" },
        "self_checks": { "type": "array", "items": { "type": "object", "required": ["gate", "status", "step", "evidence_ref"], "properties": { "gate": { "enum": ["test_gate", "lint_gate"] }, "status": { "enum": ["passed", "failed"] }, "step": { "type": "string" }, "exit_code": { "type": "integer" }, "evidence_ref": { "type": "string" } }, "additionalProperties": false },
        "failure": { "type": "object" }
      }, "additionalProperties": false } }
    }
  }, "additionalProperties": false
}
