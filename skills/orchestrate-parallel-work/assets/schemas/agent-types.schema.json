{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orchestrate-parallel-work.local/schemas/agent-types.schema.json",
  "title": "Agent Type Catalog v1",
  "type": "object",
  "required": ["schema_version", "agent_types"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "agent_types": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["agent_type_id", "title", "purpose", "capabilities", "allowed_tools", "permission_profile", "default_owned_scopes", "max_instances", "validator"],
        "properties": {
          "agent_type_id": { "type": "string", "minLength": 1 }, "title": { "type": "string", "minLength": 1 }, "purpose": { "type": "string", "minLength": 1 },
          "capabilities": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "allowed_tools": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "permission_profile": { "type": "string", "minLength": 1 },
          "default_owned_scopes": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "max_instances": { "type": "integer", "minimum": 1, "maximum": 14 }, "validator": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
